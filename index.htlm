<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="LA1337 — KIFF AND MUSIC. Écoutez la radio, retrouvez les émissions et participez à l'antenne."><title>LA1337 — KIFF AND MUSIC</title><style>*{box-sizing:border-box}body{margin:0;color:#f7f5f5;background:radial-gradient(ellipse at 25% 35%,#633d40 0,transparent 52%),radial-gradient(ellipse at 85% 10%,#405256 0,transparent 60%),linear-gradient(#44494b,#151311 85%);background-attachment:fixed;font:15px Arial,sans-serif;min-height:100vh;padding-bottom:90px}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}button,a,input,textarea,select{outline-offset:4px}button{cursor:pointer;color:inherit;background:#ffffff0c;border:1px solid #ffffff30;border-radius:24px;padding:12px 18px}button:hover,a:hover{color:#ff4251}header{max-width:1160px;margin:auto;display:flex;align-items:center;gap:25px;padding:20px 16px}.brand{display:flex;align-items:center;gap:8px;font-size:23px;font-weight:900;white-space:nowrap}.brand img{width:36px;height:36px;object-fit:contain}nav{display:flex;flex:1;gap:19px;align-items:center;flex-wrap:wrap;font-size:13px;color:#c0bfc3}nav a.active{color:white;border-bottom:2px solid #ff243a;padding-bottom:9px}.outline{border-color:#e52b3c;color:#ff3346;white-space:nowrap}main{max-width:1170px;margin:auto;padding:45px 24px;min-height:75vh}.hero{display:grid;grid-template-columns:minmax(0,416px) minmax(0,552px);gap:68px;align-items:center;padding-top:85px;padding-bottom:110px}.cover{width:100%;aspect-ratio:1;object-fit:cover;border-radius:14px;box-shadow:0 28px 55px #0007}.eyebrow{display:inline-block;border:1px solid #ffffff20;background:#ffffff0c;border-radius:30px;padding:9px 13px;font-weight:bold;font-size:12px}.dot{color:#ff3345}.hero h1{font-family:Impact,'Arial Narrow',Arial,sans-serif;font-stretch:condensed;font-size:clamp(42px,6vw,96px);line-height:.98;letter-spacing:-3px;margin:18px 0 10px;text-transform:uppercase;overflow-wrap:anywhere}.artist{color:#ff3345;font-size:24px;font-weight:bold;text-transform:uppercase;margin:0 0 30px}.actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.round{border:0;border-radius:50%;background:white;color:#151515;width:45px;height:45px;padding:0;font-size:20px;flex:none}.listen{display:flex;align-items:center;gap:12px;text-align:left;padding:6px 20px 6px 6px;background:#ffffff15}.listen .round{background:#ed1027;color:white;width:52px;height:52px;display:grid;place-items:center}.listen small{display:block;color:#c1bec2}.next{margin-top:30px;padding:16px;border:1px solid #ffffff20;background:#ffffff0b;border-radius:13px}.next small{color:#ff3447;font-weight:bold;letter-spacing:1px}.next strong{display:block;margin:8px 0}.muted,small{color:#c1bec2}.player{position:fixed;bottom:0;left:0;right:0;background:#111113;border-top:1px solid #ffffff18;z-index:5}.player-inner{max-width:1100px;margin:auto;display:flex;align-items:center;gap:13px;padding:12px 16px}.player img{width:44px;height:44px;border-radius:7px;object-fit:cover}.track{flex:1;min-width:0}.track strong,.track small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#volume{width:100px;accent-color:white}#mute{border:0;padding:6px}footer{max-width:1120px;margin:auto;padding:20px;color:#c1bec2;font-size:13px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}.panel{background:#ffffff0b;border:1px solid #ffffff25;border-radius:12px;padding:20px;margin-bottom:15px}.panel img{width:100%;max-height:250px;object-fit:cover;border-radius:8px}.panel p{white-space:pre-wrap}label{display:block;margin:12px 0}input:not([type=range]),textarea,select{display:block;width:100%;background:#171719;color:white;border:1px solid #777;border-radius:7px;padding:12px;margin-top:6px}textarea{min-height:120px}.form{max-width:650px}.trap{position:absolute;left:-10000px}.skip{position:absolute;left:-10000px}.skip:focus{left:10px;top:10px;background:black;z-index:9}.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.history{display:grid;grid-template-columns:52px 1fr auto;gap:14px;align-items:center}.history img{width:52px;height:52px}.history p{margin:4px 0}#status{font-size:12px;color:#bbb}@media(max-width:850px){header{flex-wrap:wrap;gap:12px}nav{order:3;flex-basis:100%;gap:12px}header .outline{margin-left:auto}.hero{gap:25px;padding-top:25px;padding-bottom:35px;grid-template-columns:1fr 1fr}.hero h1{letter-spacing:-1px}.artist{font-size:18px}}@media(max-width:580px){main{padding:24px 18px}.hero{grid-template-columns:1fr}.cover{max-width:360px;justify-self:center}.hero h1{font-size:48px}.player-inner{gap:8px}#volume{width:65px}#status{display:none}.player img{width:36px;height:36px}.history{grid-template-columns:40px 1fr}.history time{grid-column:2}.hero .next{margin-top:20px}}
.outline-link{border:1px solid #ffffff30;border-radius:24px;padding:15px 20px;font-weight:bold}

/* Adaptation GitHub Pages : la navigation est en #/chemin pour rester utilisable sur une sous-URL */
</style></head>
<body><header><a class="brand" href="#/"><img src="data:image/webp;base64," alt=""><b>LA1337</b></a><nav aria-label="Navigation principale" id="nav"></nav><button class="outline" id="topplay">▶ Écouter</button></header>
<main id="main" tabindex="-1"></main><footer><a href="#/mentions">Mentions légales et confidentialité</a> · LA1337 — KIFF AND MUSIC</footer>
<section class="player" aria-label="Lecteur radio"><div class="player-inner"><button id="play" class="round" aria-label="Écouter">▶</button><img id="mini" src="data:image/svg+xml;base64," alt=""><div class="track"><strong id="ptitle">LA1337</strong><small id="partist">Flux non configuré</small></div><span id="status" role="status"></span><button id="mute" aria-label="Couper le son">◖))</button><input id="volume" aria-label="Volume" type="range" min="0" max="1" step="0.01" value="0.8"></div></section><audio id="audio" preload="none"></audio><script>const COVER="data:image/svg+xml;base64,";
(()=>{'use strict';
// CONFIGURATION PUBLIQUE UNIQUEMENT. Ne jamais placer de mot de passe ni de jeton ici.
const CONFIG={
  streamUrl:'',          // URL HTTPS publique du flux radio (MP3/AAC)
  studioPublicApiUrl:'', // URL HTTPS publique de l'API du Studio (CORS requis)
  callUrl:'',            // URL HTTPS de la page WebRTC /appeler, si opérationnelle
  shows:[], podcasts:[], articles:[], team:[], shop:[],
  legal:'Mentions légales et informations de confidentialité à compléter avant publication officielle.'
};
const $=id=>document.getElementById(id), main=$('main'),audio=$('audio');
const routes={'/':'Accueil','/grille':'Grille','/emissions':'Émissions','/podcasts':'Podcasts','/titres':'Titres','/dedicaces':'Dédicaces','/actus':'Actus','/equipe':'L’équipe','/radio':'La radio','/contact':'Contact','/boutique':'Boutique','/appeler':'Appeler'};
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safe=v=>{if(!v)return '';try{let u=new URL(v,location.href);return ['https:','http:','data:'].includes(u.protocol)?esc(u.href):''}catch{return ''}};
const path=()=>{let h=decodeURI(location.hash.slice(1));return routes[h]||h==='/mentions'?h:'/'};
const href=p=>'#'+p;
let live={title:null,artist:null,cover:null,stream:CONFIG.streamUrl,callUrl:CONFIG.callUrl,history:[],schedule:[],next:null,standard:'indisponible'},mode='radio',wanted=false,retry=0,timer=null;
$('nav').innerHTML=Object.entries(routes).map(([p,n])=>`<a href="${href(p)}">${esc(n)}</a>`).join('');
const date=v=>{if(!v)return 'Date non renseignée';let d=new Date(typeof v==='number'&&v<1e12?v*1000:v);return isNaN(d)?'Date non renseignée':new Intl.DateTimeFormat('fr-FR',{dateStyle:'short',timeStyle:'short',timeZone:'Europe/Paris'}).format(d)};
function sync(){let playing=!audio.paused&&!audio.ended&&audio.readyState>=3;let state=playing?(mode==='podcast'?'Replay en écoute':'En écoute'):wanted?'Connexion…':live.stream?'Écouter':'Flux non configuré';$('play').textContent=wanted?'Ⅱ':'▶';$('play').setAttribute('aria-label',wanted?'Pause':'Écouter');$('topplay').textContent=(wanted?'Ⅱ ':'▶ ')+state;$('ptitle').textContent=live.title||'LA1337';$('partist').textContent=live.artist||'KIFF AND MUSIC';$('mini').src=safe(live.cover)||COVER;if($('heroPlay')){$('heroPlay').querySelector('.round').textContent=wanted?'Ⅱ':'▶';$('heroState').textContent=state;$('heroHint').textContent=wanted?'Touchez pour arrêter':'Écoutez le direct'}}
function reconnect(){if(!wanted||timer||!live.stream)return;$('status').textContent='Reconnexion…';timer=setTimeout(()=>{timer=null;if(wanted){audio.src=live.stream;audio.play().catch(reconnect)}},Math.min(30000,1000*2**retry++))}
async function toggle(){if(wanted||!audio.paused){wanted=false;clearTimeout(timer);timer=null;audio.pause();$('status').textContent='En pause';sync();return}if(!live.stream){$('status').textContent='Flux non configuré';if($('heroHint'))$('heroHint').textContent='Flux non configuré';return}mode='radio';wanted=true;retry=0;audio.src=live.stream;sync();try{await audio.play()}catch{wanted=false;$('status').textContent='Lecture impossible';sync()}}
for(const id of ['play','topplay'])$(id).onclick=toggle;
audio.addEventListener('playing',()=>{retry=0;clearTimeout(timer);timer=null;$('status').textContent=mode==='podcast'?'Replay':'En écoute';sync()});for(const e of ['waiting','stalled'])audio.addEventListener(e,()=>{if(wanted){$('status').textContent='Connexion…';sync();reconnect()}});for(const e of ['error','ended'])audio.addEventListener(e,reconnect);audio.addEventListener('pause',sync);$('volume').oninput=e=>audio.volume=Number(e.target.value);audio.volume=.8;$('mute').onclick=()=>{audio.muted=!audio.muted;$('mute').textContent=audio.muted?'🔇':'◖))';$('mute').setAttribute('aria-pressed',audio.muted)};
const empty=t=>`<div class="panel muted">${esc(t)}</div>`;
const card=x=>`<article class="panel">${x.image&&safe(x.image)?`<img src="${safe(x.image)}" alt="" loading="lazy">`:''}<h2>${esc(x.title)}</h2><small>${esc([x.host,x.day,x.start&&x.end?x.start+' – '+x.end:'',x.category,x.date,x.duration,x.price].filter(Boolean).join(' · '))}</small><p>${esc(x.description)}</p>${x.audio&&safe(x.audio)?`<button data-podcast="${safe(x.audio)}">Écouter le replay</button>`:''}</article>`;
const cards=(xs,msg)=>xs?.length?`<div class="cards">${xs.map(card).join('')}</div>`:empty(msg);
function render(){let p=path();document.title=(routes[p]||'Mentions légales')+' — LA1337';document.querySelectorAll('nav a').forEach(a=>{let active=a.getAttribute('href')===href(p);a.classList.toggle('active',active);if(active)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')});if(p==='/'){main.innerHTML=`<section class="hero"><img class="cover" src="${safe(live.cover)||COVER}" alt="Pochette du titre ou visuel LA1337"><div><span class="eyebrow"><span class="dot">●</span> EN CE MOMENT</span><h1>${esc(live.title||'LA1337')}</h1><p class="artist">${esc(live.artist||'KIFF AND MUSIC')}</p>${!live.title?'<p class="muted">Titre en cours non communiqué par le Studio.</p>':''}<div class="actions"><button class="listen" id="heroPlay"><span class="round">▶</span><span><strong id="heroState">Écouter</strong><small id="heroHint">Écoutez le direct</small></span></button><a class="outline-link" href="${href('/titres')}">Titres diffusés</a></div><div class="next"><small>ENSUITE ${esc(live.next?.day?' · '+live.next.day:'')}</small><strong>${esc(live.next?.title||live.next?.name||'Émission suivante non communiquée')}</strong><span class="muted">${esc(live.next?.start&&live.next?.end?live.next.start+' – '+live.next.end:'Grille à synchroniser')}</span></div></div></section>`;$('heroPlay').onclick=toggle}
else if(p==='/titres'){main.innerHTML='<h1>Titres diffusés</h1><p class="muted">Historique réel transmis par le Studio, lorsqu’il sera connecté.</p>'+(live.history?.length?live.history.map(x=>`<article class="panel history"><img src="${safe(x.cover)||COVER}" alt=""><div><strong>${esc(x.title)}</strong><p>${esc(x.artist||'Artiste non communiqué')}</p><small>${esc(x.show||'')}</small></div><time>${esc(date(x.at||x.date))}</time></article>`).join(''):empty('Aucun historique réel disponible.'))}
else if(p==='/grille'){let days=['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche'];let xs=live.schedule?.length?live.schedule:CONFIG.shows||[];main.innerHTML='<h1>Grille des programmes</h1><p class="muted">Heure de Paris · '+(live.schedule?.length?'Grille Studio':'Grille éditoriale')+'</p>'+days.map(d=>`<h2>${d}</h2>${cards(xs.filter(x=>String(x.day).toLowerCase()===d.toLowerCase()),'Aucun programme publié.')}`).join('')}
else if(p==='/dedicaces'||p==='/contact'){main.innerHTML=`<h1>${esc(routes[p])}</h1><div class="panel"><h2>Service en préparation</h2><p>Les messages ne peuvent pas être envoyés depuis cette version GitHub Pages. Les formulaires seront activés après connexion à un serveur sécurisé pour la modération.</p></div>`}
else if(p==='/appeler'){main.innerHTML=`<h1>Appeler LA1337</h1><div class="panel"><h2>Standard ${esc(live.standard||'indisponible')}</h2><p>Cette page sera connectée au véritable standard du Studio.</p>${live.standard==='disponible'&&live.callUrl?`<a class="outline-link" href="${safe(live.callUrl)}" target="_blank" rel="noopener">Ouvrir le standard</a>`:'<p>Le standard ne peut pas recevoir d’appel actuellement.</p>'}</div>`}
else if(p==='/radio'){main.innerHTML='<h1>LA1337</h1><div class="panel"><h2>KIFF AND MUSIC</h2><p>Retrouvez le direct, les émissions et les podcasts de LA1337.</p></div>'}
else if(p==='/mentions'){main.innerHTML='<h1>Mentions légales et confidentialité</h1><div class="panel"><p>'+esc(CONFIG.legal)+'</p><p>La version statique ne collecte pas de dédicaces ni de messages. Aucun compte animateur n’est hébergé sur GitHub Pages.</p></div>'}
else {let key={'/emissions':'shows','/podcasts':'podcasts','/actus':'articles','/equipe':'team','/boutique':'shop'}[p];let xs=CONFIG[key]||[];main.innerHTML=`<h1>${esc(routes[p])}</h1>${p==='/podcasts'?'<label>Rechercher<input id="search" type="search"></label><label>Catégorie<select id="filter"><option value="">Toutes</option>'+[...new Set(xs.map(x=>x.category).filter(Boolean))].map(c=>`<option>${esc(c)}</option>`).join('')+'</select></label>':''}<div id="catalog">${cards(xs,'Aucun contenu publié pour le moment.')}</div>${p==='/boutique'?'<p class="muted">Catalogue uniquement, aucun paiement en ligne.</p>':''}`;if($('search')){let f=()=>{$('catalog').innerHTML=cards(xs.filter(x=>JSON.stringify(x).toLowerCase().includes($('search').value.toLowerCase())&&(!$('filter').value||x.category===$('filter').value)),'Aucun résultat.')};$('search').oninput=f;$('filter').onchange=f}}sync()}
document.addEventListener('click',e=>{let podcast=e.target.closest('[data-podcast]');if(podcast){mode='podcast';wanted=false;audio.pause();clearTimeout(timer);timer=null;audio.src=podcast.dataset.podcast;audio.play().then(()=>{$('status').textContent='Replay';sync()}).catch(()=>{$('status').textContent='Replay indisponible'});return}});
window.addEventListener('hashchange',()=>{render();main.focus();window.scrollTo(0,0)});
async function refresh(){if(!CONFIG.studioPublicApiUrl)return;try{let r=await fetch(CONFIG.studioPublicApiUrl,{cache:'no-store'});if(!r.ok)throw Error('API indisponible');let s=await r.json();live={...live,title:s.title||null,artist:s.artist||null,cover:s.cover||s.artwork||null,stream:s.stream||CONFIG.streamUrl,history:Array.isArray(s.history)?s.history:[],schedule:Array.isArray(s.schedule)?s.schedule:[],next:s.next||null,standard:s.standard===true||s.standard==='available'?'disponible':'indisponible',callUrl:s.callUrl||CONFIG.callUrl};if(['/','/titres','/grille','/appeler'].includes(path()))render();else sync()}catch{$('status').textContent='Studio indisponible'}}
render();refresh();if(CONFIG.studioPublicApiUrl)setInterval(refresh,15000);
})();</script></body></html>